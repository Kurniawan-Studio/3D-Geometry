import { describe, it, expect } from 'vitest';
import { polyhedronMeasures, regularPolygonArea } from '../math';
import { validatePolygon } from '../polygon';

describe('polyhedronMeasures', () => {
  it('cube V=a³', () => {
    const m = polyhedronMeasures('cube', 2);
    expect(m.volume).toBe(8);
    expect(m.surface).toBe(24);
  });
  it('tetrahedron reference', () => {
    const m = polyhedronMeasures('tetrahedron', 1);
    expect(m.volume).toBeCloseTo(0.11785, 4);
  });
});

describe('validatePolygon', () => {
  it('rejects <3 points', () => {
    expect(validatePolygon([{ x: 0, y: 0 }, { x: 1, y: 0 }]).valid).toBe(false);
  });
  it('rejects self-intersection', () => {
    const bowtie = [{ x: 0, y: 0 }, { x: 1, y: 1 }, { x: 1, y: 0 }, { x: 0, y: 1 }];
    expect(validatePolygon(bowtie).valid).toBe(false);
  });
  it('accepts square', () => {
    const sq = [{ x: 0, y: 0 }, { x: 1, y: 0 }, { x: 1, y: 1 }, { x: 0, y: 1 }];
    expect(validatePolygon(sq).valid).toBe(true);
  });
});
